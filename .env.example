# ===== MAJBURIY =====
# ASOSIY botning tokeni (@BotFather). Bo'lim botlari tokenlari bot ichidan qo'shiladi.
BOT_TOKEN=123456789:AAAA-your-token-here

# Superadmin(lar) Telegram ID si, vergul bilan: 111111111,222222222  (ID ni @userinfobot dan bilish mumkin)
SUPERADMIN_IDS=123456789

# ===== IXTIYORIY (standart qiymatlar ko'rsatilgan) =====
# Nisbiy yo'llar loyiha papkasiga nisbatan olinadi.
DB_PATH=data/bot.db

# Bo'lim botlari tokenlarini shifrlash kaliti.
# Bo'sh qoldirsangiz, data/.secret.key faylida avtomatik yaratiladi.
# MUHIM: bu kalitni yo'qotsangiz, bo'lim botlari tokenlarini qaytadan kiritishga to'g'ri keladi.
# Yangi kalit: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=

# Log darajasi: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Log faylga ham yozish (bo'sh = faqat konsol / journalctl). Masalan: logs/bot.log (10 MB x 5 ta aylanadi)
LOG_FILE=

# Avtomatik zaxira nusxa: har kuni shu soatda (0..23), -1 = o'chirish
BACKUP_HOUR=3
# Nechta oxirgi nusxa saqlansin
BACKUP_KEEP=14
BACKUP_DIR=data/backups
